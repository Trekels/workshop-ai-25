{
  "name": "trekels/workshop-ucll-25",
  "description": "An introduction to building AI RAG in PHP",
  "type": "project",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "require": {
    "php": "8.4.*",
    "ext-pdo": "*",
    "ext-sqlite3": "*",
    "slim/slim": "^4.15",
    "guzzlehttp/psr7": "^2.8",
    "league/container": "^5.1",
    "guzzlehttp/guzzle": "^7.10",
    "symfony/form": "^7.3",
    "twig/twig": "^3.21",
    "symfony/twig-bridge": "^7.3",
    "vlucas/phpdotenv": "^5.6",
    "openai-php/client": "^0.17.1"
  },
  "config": {
    "platform": {
      "php": "8.4"
    },
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
